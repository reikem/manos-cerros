---
// Ladera de Valparaíso generada al compilar: casas de colores, ventanas que se encienden
// y un ascensor que sube por el cerro mientras se hace scroll.
const W = 1200, H = 280, ROWS = 4, ROW_H = 44;
let seed = 11;
const rnd = () => (seed = (seed * 16807) % 2147483647) / 2147483647;
const palette = ['#2f7f78', '#b8783e', '#8f4b5a', '#c9a24a', '#3b6a8c', '#d9d2c0'];
const shade = (hex: string, f: number) =>
  '#' + [1, 3, 5].map((i) => Math.round(parseInt(hex.slice(i, i + 2), 16) * f).toString(16).padStart(2, '0')).join('');
const top = (x: number) => 78 + 42 * Math.cos((x / W) * Math.PI * 1.7 + 0.4);

interface House { x: number; y: number; w: number; h: number; c: string; roof: string; row: number; p: string }
const houses: House[] = [];
for (let r = 0; r < ROWS; r++) {
  let x = -12 + r * 15;
  while (x < W) {
    const w = 44 + Math.floor(rnd() * 30);
    const c = palette[Math.floor(rnd() * palette.length)];
    houses.push({ x, y: top(x + w / 2) + r * ROW_H, w, h: ROW_H + 2, c, roof: shade(c, 0.72), row: r, p: rnd().toFixed(2) });
    x += w + 2;
  }
}
const hill = Array.from({ length: 31 }, (_, i) => `${i * 40},${top(i * 40) + 10}`).join(' ');
const A = { x: 96, y: 262 }, B = { x: 300, y: 92 };
const angle = (Math.atan2(B.y - A.y, B.x - A.x) * 180) / Math.PI;
---
<section class="cerro anim-cerro" aria-labelledby="t-cerro">
  <div class="container"><h2 id="t-cerro" class="lema">Cada cerro tiene su ascensor y cada esquina, su vendedor.</h2></div>
  <div class="escena" aria-hidden="true">
    <svg viewBox={`0 0 ${W} ${H}`} preserveAspectRatio="xMidYMax slice" focusable="false">
      <defs><linearGradient id="fade" x1="0" y1="0" x2="0" y2="1"><stop class="f0" offset="0.55" /><stop class="f1" offset="1" /></linearGradient></defs>
      <polygon class="ladera" points={`0,${H} ${hill} ${W},${H}`} />
      {houses.map((h) => (
        <g opacity={[0.5, 0.68, 0.84, 1][h.row]}>
          <polygon points={`${h.x - 3},${h.y} ${h.x + h.w / 2},${h.y - 13} ${h.x + h.w + 3},${h.y}`} fill={h.roof} />
          <rect x={h.x} y={h.y} width={h.w} height={h.h} fill={h.c} />
          <rect class="anim-windows" x={h.x + h.w * 0.3} y={h.y + 12} width="9" height="13" fill="#f5d77a" style={`--p:${h.p}`} />
        </g>
      ))}
      <line class="riel" x1={A.x - 6} y1={A.y + 4} x2={B.x - 6} y2={B.y + 4} />
      <line class="riel" x1={A.x + 6} y1={A.y - 4} x2={B.x + 6} y2={B.y - 4} />
      <g transform={`translate(${A.x} ${A.y})`}>
        <g class="anim-funicular">
          <g transform={`rotate(${angle.toFixed(1)})`}>
            <rect x="-16" y="-22" width="32" height="20" rx="2" fill="#b8783e" stroke="#0b2233" stroke-width="1.5" />
            <rect x="-11" y="-18" width="22" height="7" fill="#f5d77a" />
          </g>
        </g>
      </g>
      <rect class="velo" x="0" y="0" width={W} height={H} fill="url(#fade)" />
    </svg>
    <div class="niebla niebla--a anim-fog"></div>
    <div class="niebla niebla--b anim-fog"></div>
  </div>
</section>
<style>
  .cerro { background: var(--bg-alt); padding-top: clamp(3.5rem, 8vw, 6rem); overflow: hidden; }
  .lema { margin: 0 0 2rem; max-width: 18em; font: italic 300 clamp(1.8rem, 4vw, 3rem) / 1.12 var(--serif); }
  .escena { position: relative; height: clamp(210px, 30vw, 360px); }
  svg { display: block; width: 100%; height: 100%; }
  .ladera { fill: var(--deep); }
  .riel { stroke: var(--hueso); stroke-opacity: .55; stroke-width: 1.5; stroke-dasharray: 5 4; }
  .f0 { stop-color: var(--deep); stop-opacity: 0; } .f1 { stop-color: var(--deep); stop-opacity: 1; }
  .niebla { position: absolute; left: -30%; width: 160%; pointer-events: none; filter: blur(22px); }
  .niebla--a { top: 8%; height: 45%; background: radial-gradient(ellipse at 30% 50%, rgba(255, 255, 255, .5), transparent 60%); }
  .niebla--b { top: 40%; height: 40%; background: radial-gradient(ellipse at 70% 50%, rgba(255, 255, 255, .38), transparent 60%); animation-direction: alternate-reverse; animation-duration: 55s; }
  @media (prefers-color-scheme: dark) { .niebla { opacity: .45; } }
</style>
