---
import ResponsiveImage from './ui/ResponsiveImage.astro';
import { images } from '../data/site';
---
<section class="section" aria-label="Valparaíso">
  <div class="container mosaic">
    {images.mosaic.map((p) => (
      <figure>
        <div class="foto anim-clip"><ResponsiveImage class="anim-settle" file={p.file} alt={p.alt} widths={[500, 800, 1100]} sizes="(min-width:800px) 30vw, 100vw" width={900} height={1200} /></div>
        <figcaption>{p.caption}</figcaption>
      </figure>
    ))}
  </div>
</section>
<style>
  .mosaic { display: grid; gap: 1.5rem; }
  figure { margin: 0; }
  .foto { aspect-ratio: 3 / 4; background: linear-gradient(160deg, #27455c, var(--mar)); overflow: hidden; }
  .foto :global(img) { width: 100%; height: 100%; object-fit: cover; }
  figcaption { margin-top: .8rem; font-size: .85rem; color: var(--fg-soft); }
  @media (min-width: 800px) {
    .mosaic { grid-template-columns: 1.2fr 1fr 1fr; align-items: start; }
    figure:nth-child(2) { margin-top: 4rem; } figure:nth-child(3) { margin-top: 1.5rem; }
  }
</style>
