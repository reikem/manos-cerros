---
// Credencial ilustrativa (frente y reverso). Los textos con data-f se rellenan con los datos del sistema municipal.
let seed = 5;
const rnd = () => (seed = (seed * 16807) % 2147483647) / 2147483647;
const N = 25;
const finder = (x: number, y: number) =>
  [[0, 0], [N - 7, 0], [0, N - 7]].some(([fx, fy]) => x >= fx && x < fx + 7 && y >= fy && y < fy + 7);
const ring = (x: number, y: number) => {
  const [fx, fy] = [[0, 0], [N - 7, 0], [0, N - 7]].find(([a, b]) => x >= a && x < a + 7 && y >= b && y < b + 7)!;
  const dx = x - fx, dy = y - fy;
  const edge = dx === 0 || dx === 6 || dy === 0 || dy === 6;
  const core = dx >= 2 && dx <= 4 && dy >= 2 && dy <= 4;
  return edge || core;
};
let d = '';
for (let y = 0; y < N; y++) for (let x = 0; x < N; x++) {
  const on = finder(x, y) ? ring(x, y) : rnd() > 0.52;
  if (on) d += `M${x} ${y}h1v1h-1z`;
}
---
<div class="cred" data-cred role="button" tabindex="0" aria-label="Ver la credencial de cerca y girarla">
  <div class="cred__scene" data-scene>
    <div class="cred__tilt" data-tilt>
      <div class="cred__flip" data-flip>
        <div class="cred__face cred__front">
          <div class="cred__top">
            <span class="cred__mosaic" aria-hidden="true"><i></i><i></i><i></i><i></i></span>
            <span class="cred__muni"><small>MUNICIPALIDAD</small><b>VALPARAÍSO</b></span>
          </div>
          <p class="cred__pill">CREDENCIAL</p>
          <p class="cred__sub">DE COMERCIO EN BNUP</p>
          <dl class="cred__rows">
            <div><dt>Nombre</dt><dd data-f="nombre">NOMBRE APELLIDO APELLIDO</dd></div>
            <div><dt>Rut</dt><dd data-f="rut">0.***.***-0</dd></div>
          </dl>
          <div class="cred__photo" aria-hidden="true">
            <svg viewBox="0 0 100 120"><circle cx="50" cy="42" r="20" /><path d="M10 120c0-30 18-46 40-46s40 16 40 46z" /></svg>
            <small>Foto en la credencial física</small>
          </div>
          <p class="cred__addr" data-f="direccion">DIRECCIÓN DEL PUESTO AUTORIZADO</p>
          <p class="cred__giro" data-f="giro">RUBRO O SECTOR</p>
          <span class="cred__tag" data-tag>Ejemplo ilustrativo</span>
          <i class="cred__c cred__c--r"></i><i class="cred__c cred__c--y"></i><i class="cred__c cred__c--g"></i>
          <span class="cred__sheen"></span>
        </div>
        <div class="cred__face cred__back">
          <span class="cred__muni cred__muni--c"><small>MUNICIPALIDAD</small><b>VAL·PA·RA·ÍSO</b></span>
          <p class="cred__legend">Esta credencial es personal e intransferible. Su alteración infringe la normativa asociada a la Ordenanza de Comercio en BNUP del Municipio.</p>
          <svg class="cred__qr" viewBox="-1 -1 27 27" aria-hidden="true"><rect x="-1" y="-1" width="27" height="27" fill="#fff" /><path d={d} fill="#1d2b6e" /></svg>
          <small class="cred__qrnote">QR ilustrativo: el real está en la credencial física</small>
          <span class="cred__sheen"></span>
        </div>
      </div>
    </div>
  </div>
</div>
<style is:global>
  .cred { cursor: zoom-in; width: min(100%, 300px); margin-inline: auto; border-radius: 16px; }
  .cred__scene { position: relative; container-type: inline-size; perspective: 1200px; width: 100%; aspect-ratio: 5 / 8; }
  .cred__tilt { position: absolute; inset: 0; transform-style: preserve-3d; transform: rotateX(var(--rx, 0deg)) rotateY(var(--ry, 0deg)) scale(var(--s, 1)); transition: transform .6s cubic-bezier(.2, .8, .2, 1); }
  .cred__tilt.mueve { transition: transform .08s linear; }
  .cred__flip { position: absolute; inset: 0; transform-style: preserve-3d; transform: rotateY(var(--ang, 0deg)); transition: transform .9s cubic-bezier(.2, .8, .2, 1); }
  .drag .cred__flip { transition: none; }
  .cred__face { position: absolute; inset: 0; backface-visibility: hidden; -webkit-backface-visibility: hidden; overflow: hidden; border-radius: 5cqw; background: #f4efe2; color: #1d2b6e; box-shadow: 0 3cqw 9cqw rgba(0, 0, 0, .35), 0 0 0 .4cqw rgba(29, 43, 110, .12); font-family: var(--sans); }
  .cred__back { transform: rotateY(180deg); display: flex; flex-direction: column; align-items: center; padding: 9cqw 9cqw 6cqw; text-align: center; gap: 6cqw; }
  .cred__front { padding: 7cqw; }
  .cred__top { display: flex; justify-content: space-between; align-items: flex-start; }
  .cred__mosaic { display: grid; grid-template-columns: 1fr 1fr; width: 14cqw; height: 14cqw; gap: .6cqw; background: #5b7aa0; padding: .6cqw; }
  .cred__mosaic i:nth-child(1) { background: #7fb08a; } .cred__mosaic i:nth-child(2) { background: #c75a8a; } .cred__mosaic i:nth-child(3) { background: #e3b94c; } .cred__mosaic i:nth-child(4) { background: #3f9aa3; }
  .cred__muni { display: grid; text-align: right; line-height: 1.05; font-weight: 800; }
  .cred__muni small { font-size: 2.4cqw; letter-spacing: .08em; font-weight: 600; } .cred__muni b { font-size: 6.4cqw; letter-spacing: .02em; }
  .cred__muni--c { text-align: center; } .cred__muni--c b { font-size: 7cqw; }
  .cred__pill { margin: 6cqw 0 0; padding: 2.2cqw 3cqw; background: #2a3d9a; color: #fff; border-radius: 8cqw; text-align: center; font-weight: 800; font-size: 10.5cqw; line-height: 1; letter-spacing: .01em; }
  .cred__sub { margin: 1.6cqw 0 0; text-align: center; font-weight: 800; font-size: 5cqw; }
  .cred__rows { margin: 5cqw 0 0; display: grid; gap: 1.6cqw; }
  .cred__rows div { display: grid; grid-template-columns: 17cqw 1fr; gap: 3cqw; align-items: baseline; }
  .cred__rows dt { margin: 0; font-weight: 600; font-size: 3.8cqw; text-align: right; } .cred__rows dd { margin: 0; font-size: 3.3cqw; font-weight: 500; line-height: 1.2; overflow-wrap: anywhere; }
  .cred__photo { margin: 4cqw auto 0; width: 44cqw; height: 44cqw; background: #dcd6c6; display: grid; place-items: center; position: relative; overflow: hidden; }
  .cred__photo svg { position: absolute; inset: 10% 20% 0; width: 60%; height: 90%; fill: #b9b2a0; }
  .cred__photo small { position: absolute; bottom: 1.5cqw; left: 0; right: 0; text-align: center; font-size: 2.6cqw; color: #5d5a50; }
  .cred__addr { margin: 4cqw 0 0; text-align: center; font-weight: 800; font-size: 3.3cqw; line-height: 1.25; text-transform: uppercase; }
  .cred__giro { margin: 2.4cqw 0 0; text-align: center; font-weight: 800; font-size: 3.3cqw; text-transform: uppercase; }
  .cred__tag { position: absolute; right: 5cqw; top: 22cqw; transform: rotate(8deg); padding: .8cqw 2.4cqw; border: .4cqw solid #c75a3a; color: #c75a3a; border-radius: 1.2cqw; font-size: 2.6cqw; font-weight: 800; letter-spacing: .04em; text-transform: uppercase; background: rgba(244, 239, 226, .9); }
  .cred__tag[data-live='true'] { border-color: #2f7f78; color: #2f7f78; }
  .cred__c { position: absolute; bottom: 0; width: 13cqw; height: 13cqw; }
  .cred__c--r { left: 0; background: #c0392b; clip-path: polygon(0 0, 100% 100%, 0 100%); }
  .cred__c--y { left: 7cqw; width: 8cqw; height: 8cqw; background: #e3b94c; bottom: 0; }
  .cred__c--g { right: 0; background: #4f9a63; clip-path: polygon(100% 0, 100% 100%, 0 100%); }
  .cred__legend { margin: 0; font-weight: 600; font-size: 5cqw; line-height: 1.35; }
  .cred__qr { width: 52cqw; height: 52cqw; border-radius: 2cqw; }
  .cred__qrnote { font-size: 2.6cqw; color: #5d5a50; }
  .cred__sheen { position: absolute; inset: 0; pointer-events: none; background: linear-gradient(115deg, transparent 38%, rgba(255, 255, 255, .6) 50%, transparent 62%); transform: translateX(-120%); }
  .flipping .cred__sheen { animation: cred-sheen .9s ease; }
  @keyframes cred-sheen { to { transform: translateX(120%); } }

  /* Vista ampliada */
  .cv { position: fixed; inset: 0; z-index: 100; display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 1.2rem; padding: 1.2rem; background: rgba(7, 21, 31, .86); backdrop-filter: blur(8px); -webkit-backdrop-filter: blur(8px); opacity: 0; transition: opacity .45s; color: var(--hueso); touch-action: none; }
  .cv.on { opacity: 1; }
  .cv__wrap { width: min(88vw, calc((100svh - 11rem) * 5 / 8), 420px); }
  .cv .cred__scene { cursor: grab; } .cv .cred__scene.drag { cursor: grabbing; }
  .cv__hint { margin: 0; font-size: .9rem; opacity: .8; text-align: center; }
  .cv__bar { display: flex; gap: .8rem; }
  .cv__bar button { padding: .7rem 1.4rem; border: 1px solid rgba(233, 235, 234, .6); border-radius: 2px; background: transparent; color: var(--hueso); font: 500 .9rem var(--sans); cursor: pointer; }
  .cv__bar button:hover { background: var(--hueso); color: var(--mar); }
</style>
